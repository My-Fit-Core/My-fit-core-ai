# 복사해서 .env로 사용하세요. 실제 값은 커밋하지 않습니다.

# 백엔드 → AI 서버 인증: 요청 헤더 X-AI-Server-Secret과 비교한다(헤더 이름은 제안). 비우면 확인하지 않는다(개발용)
AI_SERVER_SECRET=
# AI 서버 → 백엔드 콜백 HMAC 서명 키 (app/callback.py)
AI_CALLBACK_HMAC_SECRET=

# 누끼 PNG는 백엔드가 준 업로드 URL로 올리므로 Supabase 키는 AI 서버에 필요 없다(10/12 회의 안건 8)

# 모델 다운로드
HF_TOKEN=
# 검출 가중치 경로 (기본 weights/deepfashion2_yolov8s-seg.pt, scripts/download_weights.py)
DETECTOR_WEIGHTS=

# LLM 코멘트 (P1)
LLM_API_KEY=

# AI Hub 데이터 다운로드 (docs/04-kfashion-validation.md)
AIHUB_API_KEY=
